PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=super_secret_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_token_key_54321

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=TEST1234567890abcdef
